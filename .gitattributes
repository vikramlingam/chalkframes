# Normalize text files to LF in the repository and on checkout.
* text=auto eol=lf

# Binary assets (bundled audio, voice previews, images, video).
*.mp3 binary
*.wav binary
*.mp4 binary
*.mov binary
*.webm binary
*.png binary
*.jpg binary
*.woff2 binary

# HTML here is generated composition output, not framework source.
*.html linguist-detectable=false
