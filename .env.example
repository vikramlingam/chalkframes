# Copy to .env and fill in what you need. Lines starting with # are comments.

# Required for generating videos (or paste the key into the web UI instead)
OPENROUTER_API_KEY=

# Server
# PORT=4000
# HOST=127.0.0.1

# Python interpreter with kokoro-onnx and soundfile installed (text to speech)
# CHALKFRAMES_PYTHON=/path/to/python

# Optional: Python interpreter with Manim Community Edition installed
# MANIM_PYTHON=/path/to/python
# Per-scene Manim time limit in milliseconds (default 60000)
# MANIM_TIMEOUT_MS=60000
