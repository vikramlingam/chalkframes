# ---------------------------------------------------------------------------
# Secrets. Never commit real keys; copy .env.example to .env instead.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# ---------------------------------------------------------------------------
# Dependencies and build output
# ---------------------------------------------------------------------------
node_modules/
dist/
*.tsbuildinfo
*.tgz

# Python (the setup script creates .venv for Kokoro and optional Manim)
.venv
venv
__pycache__/
*.pyc

# ---------------------------------------------------------------------------
# Model weights and browser downloads. These are fetched by `bun run setup`
# into ~/.cache/chalkframes and must never be committed.
# ---------------------------------------------------------------------------
*.onnx
*.safetensors
*.pt
*.pth
*.ckpt
voices-v*.bin
chrome/
chrome-headless-shell/

# ---------------------------------------------------------------------------
# Generated at run time
# ---------------------------------------------------------------------------
/projects/
studio-web/renders/
renders/
output/
.chalkframes/
.thumbnails/
.transcode-cache/
/media/

# Generated sources that the build recreates
packages/core/src/generated/*
!packages/core/src/generated/position-edits-render-inline.ts
!packages/core/src/generated/position-edits-render-inline.test.ts
packages/producer/src/services/fontData.generated.ts

# ---------------------------------------------------------------------------
# Logs, scratch, coverage
# ---------------------------------------------------------------------------
*.log
npm-debug.log*
tmp/
.tmp/
/soundtracks/
coverage/
.debug/

# ---------------------------------------------------------------------------
# OS and editors
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
.zed/
*.swp
*.swo
