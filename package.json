{
  "name": "chalkframes",
  "private": true,
  "description": "Chalk Frames — Autonomous AI video rendering and production suite",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "node --watch studio-web/server.mjs",
    "studio": "node studio-web/server.mjs",
    "build": "bun run --filter '@hyperframes/{parsers,lint,studio-server}' build && bun run --filter @hyperframes/core build && bun run --filter @hyperframes/engine build && bun run --filter @hyperframes/producer build && bun run --filter @hyperframes/cli build",
    "build:hyperframes-runtime": "bun run --filter @hyperframes/core build:hyperframes-runtime",
    "build:hyperframes-runtime:modular": "bun run --filter @hyperframes/core build:hyperframes-runtime:modular",
    "test": "bun run test:studio",
    "test:studio": "node --test studio-web/quality.test.mjs studio-web/server.test.mjs",
    "lint": "oxlint studio-web",
    "lint:fix": "oxlint --fix studio-web",
    "format": "oxfmt studio-web",
    "format:check": "oxfmt --check studio-web"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "pdf-parse": "^2.4.5",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.11"
  }
}
